# Docker Compose configuration. Copy to `.env` (git-ignored) and fill in every value marked REQUIRED.
# Nothing in docker-compose.yml has a default secret.

# REQUIRED: Laravel application key. Generate:  docker compose run --rm backend php artisan key:generate --show
APP_KEY=

# REQUIRED: database password (any strong random string)
POSTGRES_PASSWORD=
# POSTGRES_DB=medimind
# POSTGRES_USER=medimind

# REQUIRED: shared secret between Laravel and the AI engine (24+ chars). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=

# REQUIRED: OpenAI API key used by the AI engine
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Host the browser uses to reach the web app (Sanctum treats only this host as first-party).
# FRONTEND_HOST=localhost:3000
# Set to true when serving over HTTPS (required in production so the session cookie is never sent over HTTP).
# SESSION_SECURE_COOKIE=false

# One-time seeding of the first admin account (`php artisan db:seed`). Required outside local/testing.
# SEED_ADMIN_PASSWORD=
# SEED_CLINIC_PASSWORD=

# `log` writes OTP codes to the Laravel log and only works with APP_ENV=local. Production needs a real
# SmsGateway implementation (see backend/app/Contracts/SmsGateway.php) and its driver name here.
# OTP_SMS_DRIVER=log
# APP_ENV=production
