# Copy to .env. Required values have no defaults: the service refuses to start without them,
# and rejects known placeholder values.

# Shared secret that Laravel sends as X-Internal-Secret. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must equal FASTAPI_INTERNAL_SECRET in backend/.env.
INTERNAL_API_SECRET=

OPENAI_API_KEY=

# Optional overrides (defaults shown)
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# QDRANT_URL=http://qdrant:6333
# OCR_LANGS=eng+hin
# MAX_UPLOAD_BYTES=20971520
# LOG_LEVEL=INFO
